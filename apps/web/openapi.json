          "detector_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Detector Scores",
            "type": "object"
          },
          "disclaimer": {
            "default": "This is a probabilistic assessment produced by automated models, not proof of manipulation or of authenticity. It can be wrong, especially for low-quality or heavily compressed video. Do not use it as the sole basis for any decision about a person; when in doubt, verify identity through other means.",
            "title": "Disclaimer",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceFrame"
            },
            "title": "Evidence",
            "type": "array"
          },
          "face_tracks": {
            "title": "Face Tracks",
            "type": "integer"
          },
          "manipulation_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Highest track score among eligible face tracks (calibrated when calibration.method is not 'none'); None if no face qualified",
            "title": "Manipulation Probability"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "title": "Models",
            "type": "array"
          },
          "processing": {
            "$ref": "#/components/schemas/ProcessingInfo"
          },
          "quality": {
            "$ref": "#/components/schemas/QualityDetails"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "suspicious_intervals": {
            "items": {
              "$ref": "#/components/schemas/SuspiciousInterval"
            },
            "title": "Suspicious Intervals",
            "type": "array"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/TrackResult"
            },
            "title": "Tracks",
            "type": "array"
          },
          "verdict": {
            "enum": [
              "authentic_likely",
              "inconclusive",
              "manipulated_likely"
            ],
            "title": "Verdict",
            "type": "string"
          },
          "verdict_reasons": {
            "items": {
              "type": "string"
            },
            "title": "Verdict Reasons",
            "type": "array"
          },
          "video": {
            "$ref": "#/components/schemas/VideoMetadata"
