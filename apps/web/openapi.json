        "title": "AnalysisCreated",
        "type": "object"
      },
      "AnalysisResult": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "title": "Analysis Id",
            "type": "string"
          },
          "calibration": {
            "$ref": "#/components/schemas/Calibration",
            "default": {
              "inputs": [],
              "method": "none",
              "note": "Scores are raw detector probabilities, not calibrated likelihoods. Thresholds are provisional until calibration (roadmap step 16)."
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence",
            "type": "string"
          },
          "decision_thresholds": {
