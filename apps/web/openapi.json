          "analysis_id",
          "verdict",
          "manipulation_probability",
          "confidence",
          "video_quality",
          "face_tracks",
          "detector_scores",
          "suspicious_intervals",
          "verdict_reasons",
          "decision_thresholds",
          "quality",
          "tracks",
          "evidence",
          "video",
          "models",
          "processing"
