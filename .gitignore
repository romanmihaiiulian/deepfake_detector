build/
dist/

# Node / web
node_modules/
apps/web/dist/
apps/web/test-results/
apps/web/playwright-report/

# Model weights (fetched by `make models`, never committed)
models/

# Runtime state of the API (uploads, results, evidence)
/var/

# Research data: lab sources, fakes, variants, benchmark runs (see docs/lab/).
