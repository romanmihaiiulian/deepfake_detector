/data/

# Downloaded test fixtures (public-domain portraits, GenD sample crops)
tests/.fixtures/

# Benchmark traces
*.npz

# Coverage, logs, local secrets
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log
.env
.env.*

# OS / editors
.DS_Store
.idea/
.vscode/
